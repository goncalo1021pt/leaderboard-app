# Copy to .env and fill in. `.env` is gitignored.

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Nothing to set for development: docker-compose.yml points the app at its own
# Postgres. Production sets DATABASE_URL to the homelab database.
# DATABASE_URL=postgres://user:password@host:5432/leaderboard

# Host port for connecting a GUI client to the dev database (default 5433).
# POSTGRES_HOST_PORT=5433

# ---------------------------------------------------------------------------
# Auth and email — dev values live in docker-compose.yml; production must set
# all of these.
# ---------------------------------------------------------------------------
# BETTER_AUTH_URL=https://leaderboard.example.com
# BETTER_AUTH_SECRET=        # 32+ random characters: openssl rand -base64 32
# SMTP_URL=smtps://user:password@smtp.provider.com:465
# MAIL_FROM="Leaderboard <leaderboard@example.com>"

# Host port for the Mailpit inbox in dev (default 8025).
# MAILPIT_HOST_PORT=8025

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------
# Turn on if hot reload stops picking up file changes.
# WATCHPACK_POLLING=true
